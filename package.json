{
  "name": "fk-unity-snippets",
  "version": "0.1.0",
  "homepage": "https://github.com/Flavkupe/FKUnitySnippets/",
  "devDependencies": {
    "gh-pages": "^6.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  },
  "scripts": {
    "deploy-webgl": "DeployWebGL.bat",
    "deploy-web": "cd FKUnitySnippetsWeb && npm run deploy",
    "deploy-all": "npm run deploy-webgl && npm run deploy-web",
    "sync-submodules": "git submodule foreach git pull origin main && git add . && git commit -m \"Update submodules to the latest versions\"",
    "update-pages": "cd FKUnitySnippetsWeb && npm run update-pages",
    "start-web": "cd FKUnitySnippetsWeb && npm run dev",
    "build-webgl": "BuildWebGL.bat",
    "start-webgl": "python SimpleHTTPServer.py 8080"
  }
}
